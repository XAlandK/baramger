    {
      "id": "R1-mars-trek",
      "name": "JPL Mars Trek",
      "provider": "NASA / JPL (Solar System Treks)",
      "homepage": "https://trek.nasa.gov/mars/",
      "role": "primary_data",
      "inResourceList": true,
      "bodyCovered": "Mars",
      "siteCoverage": [
        "global",
        "Jezero crater",
        "Gale crater",
        "other landing sites"
      ],
      "access": [
        {
          "type": "wmts",
          "url": "https://trek.nasa.gov/tiles/Mars/EQ/{productLabel}/1.0.0/{Style}/{TileMatrixSet}/{TileMatrix}/{TileRow}/{TileCol}.{png|jpg}",
          "notes": "GetCapabilities at .../{productLabel}/1.0.0/WMTSCapabilities.xml. Level 0 = 2 cols x 1 row (equirectangular)."
        },
        {
          "type": "search_api",
          "url": "https://trek.nasa.gov/mars/TrekServices/ws/index/eq/searchItems?start=0&rows=200&key={keyword}&proj=urn:ogc:def:crs:IAU2000::49900",
          "notes": "Solr index; returns productLabel, bbox, fileSize, projection."
        },
        {
          "type": "download",
          "url": "https://trek.nasa.gov/mars/TrekWS/rest/cat/data/stream?label={productLabel}",
          "notes": "Full file (GeoTIFF or zip). Server ignores HTTP Range: whole file only."
        },
        {
          "type": "download",
          "url": "https://trek.nasa.gov/mars/TrekWS/rest/cat/metadata/stream?label={productLabel}",
          "notes": "FGDC XML metadata."
        },
        {
          "type": "download",
          "url": "https://asc-pds-services.s3.us-west-2.amazonaws.com/mosaic/mars2020_trn/HiRISE/JEZ_hirise_soc_006_DTM_MOLAtopography_DeltaGeoid_1m_Eqc_latTs0_lon0_blend40.tif",
          "notes": "Same HiRISE DEM product, hosted by its producer (USGS Astrogeology, Mars 2020 TRN release). Supports HTTP range reads, so only the walk area is read. Checked 2026-11-14: 1,839,545,409 bytes, eqc sphere R=3396190."
        }
      ],
      "license": "NASA data, generally public domain",
      "credit": "NASA/JPL-Caltech Mars Trek; instrument teams per layer",
      "verified": {
        "date": "2026-11-14",
        "status": "ok",
        "notes": "WMTS, search and download endpoints answered 200. HiRISE Jezero DEM has no WMTS (404) — download only."
      },
      "caveats": [
        "Perseverance traverse layer created 2024-07-03; ends near sol 1219.",
        "HiRISE Jezero mosaic ~9.8 GB, DEM ~1.8 GB.",
        "Trek's whole-file DEM download was very slow (down to ~30 KB/s) and cannot resume; use the USGS copy for windows."
      ]
    },
