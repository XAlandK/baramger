// Cloudflare deploy config: the built app (dist/) is served as static files, and a small Worker
// (worker/index.ts) answers POST /api/chat, the mission assistant. Deploy with `npm run deploy`
// (builds first). See CLAUDE.md "How to run" and "Mission assistant".
//
// The five AI keys are Worker secrets, set once per account (never in this file or in git):
//   npx wrangler secret put GEMINI_API_KEY      (and GROQ_API_KEY, OPENROUTER_API_KEY, MISTRAL_API_KEY, CEREBRAS_API_KEY)
// For `wrangler dev`, put them in app/.dev.vars (git-ignored).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "baramger",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // only the API runs the Worker; every other path is a static file, as before
    "run_worker_first": ["/api/*"]
  },
  // Per-visitor limit for the assistant: 5 questions a minute (key = the visitor's IP, not stored).
  "ratelimits": [
    { "name": "ASK_LIMIT", "namespace_id": "2026111501", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    // Other sites allowed to call /api/chat from the browser: the live site on Vercel.
    "ALLOWED_ORIGINS": "https://baramger.vercel.app"
  },
  // Run the Worker near Google Cloud us-east4, not in the data centre nearest the visitor:
  // Gemini refuses calls from some places (e.g. Cloudflare's Hong Kong data centre), and rule C1
  // keeps our calls out of China. Static files are still served from everywhere.
  "placement": { "mode": "targeted", "region": "gcp:us-east4" },
  // Workers Logs: one line per question (which provider answered, why others were skipped; never the question).
  "observability": { "enabled": true }
}
