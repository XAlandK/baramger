{
  "name": "baramger-app",
  "private": true,
  "version": "0.1.0",
  "description": "Baramger Marswalk planner: whole-Mars globe, Plan, Walk, helmet display and replay for two walk zones in Jezero crater",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "cesium": "1.146.0"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
